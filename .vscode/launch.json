{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "🚀 Launch Full MERN Stack (Frontend + Backend with Debug)",
      "configurations": ["Debug Backend", "Start Frontend"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Debug Backend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run-script", "dev"],
      "env": {
        "NODE_ENV": "development",
        "PORT": "4000"
      },
      "console": "integratedTerminal",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Start Frontend",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "command": "npm start",
      "env": {
        "BROWSER": "chrome"
      }
    }
  ]
}